Set Variable SourceDir == data
Set Variable FullDir == <<SourceDir>>\terrain
Read GIS Z Shape == <<FullDir>>\existing.shp >> terrain
Read GIS Z Shape == <<FullDir>>\missing.shp
Read GIS BC == <<MissingVariable>>\not_a_missing_file.shp
Read GIS PO == <<~s1~>>\runtime.shp
If Scenario == DEV
    Set Variable ConditionalDir == conditional
End If
Read GIS BC == <<ConditionalDir>>\unresolvable.shp
